# Custom haproxy.cfg for claudable-dockerproxy (tecnativa/docker-socket-proxy v0.5.0).
#
# Identical to the image's stock config EXCEPT the idle timeouts in `defaults`:
# the stock `timeout client/server 10m` cut every long-lived idle Docker API
# stream. Claudable attaches to each preview's dev server via a foreground
# `docker run` through this proxy — a dev server that logs nothing for 10
# minutes had its attach stream severed, the docker CLI exited, and Claudable's
# exit handler tore down the (perfectly healthy) container. Users saw previews
# "restarting" every 10-20 minutes while doing nothing.
#
# Idle streams are legitimate here (quiet dev servers can sit silent for
# hours; the PreviewManager has its own 1h idle evictor), so client/server/
# tunnel timeouts are disabled. Request-parsing timeouts stay strict.
#
# Mounted as /usr/local/etc/haproxy/haproxy.cfg.template (NOT haproxy.cfg —
# the image's entrypoint regenerates haproxy.cfg from this template at every
# start, substituting ${BIND_CONFIG}; mounting the final file broke boot on a
# read-only filesystem error). Reload note: haproxy runs in master-worker
# mode (-W) — config reloads take SIGUSR2, not SIGHUP.

global
    log stdout format raw daemon "${LOG_LEVEL}"
    # Room to buffer a whole /containers/create body for the policy below.
    tune.bufsize 131072

    pidfile /run/haproxy.pid
    maxconn 4000

    # Turn on stats unix socket
    server-state-file /var/lib/haproxy/server-state

defaults
    mode http
    log global
    option httplog
    option dontlognull
    option http-server-close
    option redispatch
    retries 3
    timeout http-request 10s
    timeout queue 1m
    timeout connect 10s
    # Idle timeouts disabled — see header. Dead peers are reaped by TCP
    # keepalive; this proxy is loopback-only with a single trusted client.
    timeout client 0
    timeout server 0
    timeout tunnel 0
    timeout http-keep-alive 10s
    timeout check 10s
    maxconn 3000

    # Allow seamless reloads
    load-server-state-from-file global

    # Use provided example error pages
    errorfile 400 /usr/local/etc/haproxy/errors/400.http
    errorfile 403 /usr/local/etc/haproxy/errors/403.http
    errorfile 408 /usr/local/etc/haproxy/errors/408.http
    errorfile 500 /usr/local/etc/haproxy/errors/500.http
    errorfile 502 /usr/local/etc/haproxy/errors/502.http
    errorfile 503 /usr/local/etc/haproxy/errors/503.http
    errorfile 504 /usr/local/etc/haproxy/errors/504.http

backend dockerbackend
    server dockersocket $SOCKET_PATH

backend docker-events
    server dockersocket $SOCKET_PATH
    timeout server 0

frontend dockerfrontend
    bind ${BIND_CONFIG}
    http-request deny unless METH_GET || { env(POST) -m bool }

    # --- Container-create policy (audit #7) ----------------------------------
    # The endpoint allowlist below cannot see WHAT is created: anyone reaching
    # this proxy could `docker run -v /:/host --privileged` = host root. Inspect
    # the create body and refuse host escapes. Legit Claudable containers only
    # bind-mount under the data root (projects, caches, agent homes, plugins,
    # npm policy) and the global skills dir, and add at most the DB caps.
    # The patterns match real JSON keys only: inside an Env value those quotes
    # are escaped (\"Privileged\"), so env content can never trigger a deny.
    option http-buffer-request
    acl c_create path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/create$
    # the whole body must be buffered and inspected — no unchecked tail
    http-request deny deny_status 403 if METH_POST c_create !{ req.hdr(content-length) -m found }
    http-request deny deny_status 403 if METH_POST c_create { req.body_size gt 100000 }
    http-request deny deny_status 403 if METH_POST c_create { req.body -m reg -i "\"Privileged\"\s*:\s*true" }
    http-request deny deny_status 403 if METH_POST c_create { req.body -m reg -i "\"(PidMode|IpcMode|UsernsMode|CgroupnsMode|UTSMode|NetworkMode)\"\s*:\s*\"host\"" }
    http-request deny deny_status 403 if METH_POST c_create { req.body -m reg -i "\"(Devices|DeviceRequests|DeviceCgroupRules)\"\s*:\s*\[\s*[\{\"]" }
    http-request deny deny_status 403 if METH_POST c_create { req.body -m reg -i "\"SecurityOpt\"\s*:\s*\[[^\]]*unconfined" }
    # an element (after "[" or ",": cap names contain no commas) outside the DB caps
    http-request deny deny_status 403 if METH_POST c_create { req.body -m reg "\"CapAdd\"\s*:\s*\[(?:[^\]]*,)?\s*\"(?!(?:CAP_)?(?:CHOWN|DAC_OVERRIDE|FOWNER|SETGID|SETUID)\")" }
    # host binds: only under the data root / global skills, never with ".."
    http-request deny deny_status 403 if METH_POST c_create { req.body -m reg "\"Binds\"\s*:\s*\[[^\]]*\"/(?!${CLAUDABLE_BIND_ALLOW})" }
    http-request deny deny_status 403 if METH_POST c_create { req.body -m reg "\"Binds\"\s*:\s*\[[^\]]*\"[^\"]*\.\.[^\"]*\"" }
    http-request deny deny_status 403 if METH_POST c_create { req.body -m reg "\"Source\"\s*:\s*\"/(?!${CLAUDABLE_BIND_ALLOW})" }
    http-request deny deny_status 403 if METH_POST c_create { req.body -m reg "\"Source\"\s*:\s*\"[^\"]*\.\.[^\"]*\"" }

    # Allowed endpoints
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/[a-zA-Z0-9_.-]+/((stop)|(restart)|(kill)) } { env(ALLOW_RESTARTS) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/[a-zA-Z0-9_.-]+/start } { env(ALLOW_START) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/[a-zA-Z0-9_.-]+/stop } { env(ALLOW_STOP) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/[a-zA-Z0-9_.-]+/pause } { env(ALLOW_PAUSE) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/[a-zA-Z0-9_.-]+/unpause } { env(ALLOW_UNPAUSE) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/auth } { env(AUTH) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/build } { env(BUILD) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/commit } { env(COMMIT) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/configs } { env(CONFIGS) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/containers } { env(CONTAINERS) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/distribution } { env(DISTRIBUTION) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/events } { env(EVENTS) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/exec } { env(EXEC) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/grpc } { env(GRPC) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/images } { env(IMAGES) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/info } { env(INFO) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/networks } { env(NETWORKS) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/nodes } { env(NODES) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/_ping } { env(PING) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/plugins } { env(PLUGINS) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/secrets } { env(SECRETS) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/services } { env(SERVICES) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/session } { env(SESSION) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/swarm } { env(SWARM) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/system } { env(SYSTEM) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/tasks } { env(TASKS) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/version } { env(VERSION) -m bool }
    http-request allow if { path,url_dec -m reg -i ^(/v[\d\.]+)?/volumes } { env(VOLUMES) -m bool }
    http-request deny
    default_backend dockerbackend

    use_backend docker-events if { path,url_dec -m reg -i ^(/v[\d\.]+)?/events }
